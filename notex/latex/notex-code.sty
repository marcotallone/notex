%┌────────────────────────────────────────────────────────────────────────────┐%
%│                                 Pseudocode                                 │%
%└────────────────────────────────────────────────────────────────────────────┘%
% pygments has no pseudocode lexer, so this one block keeps running on
% `listings`. That also buys the thing pseudocode actually needs and minted
% cannot give: real math mode anywhere in the body, not just in comments.
%
%   \begin{pseudocode}[caption = {Random shuffle}, label = {lst:shuffle}]
%   function shuffle(A):
%       N $\leftarrow$ length(A)
%       swap A[i] and A[j]
%   \end{pseudocode}
%
% Line numbers are off by default here, same as everywhere else; turn them on
% per block with [linenos] (or [linenos=true]).

\lstdefinelanguage{notexpseudo}{
  % Control flow and structure
  morekeywords = {
    algorithm, procedure, function, method, routine,
    begin, end, endif, endwhile, endfor, endfunction, endprocedure,
    if, then, else, elif, elseif, otherwise,
    for, foreach, each, while, do, repeat, until, loop,
    to, downto, step, in, of,
    return, yield, break, continue, exit, goto,
    and, or, not, xor, mod, div,
    let, set, new, define, declare, assign,
    input, output, print, read, write, error, assert,
    true, false, nil, null, none, empty
  },
  % Common pseudocode "builtins"
  morekeywords = [2]{
    length, size, count, min, max, abs, floor, ceil, round, sqrt, sum,
    append, insert, delete, remove, push, pop, top, front, back,
    swap, exchange, sort, reverse, merge, partition, search
  },
  sensitive    = false,           % `IF` and `if` are the same keyword
  morecomment  = [l]{//},         % line comment
  morecomment  = [l]{\#},         % line comment, alternative marker
  morestring   = [b]",
}

% The static half of the styling lives in a listings style of its own rather
% than in `listing options` below.
% NOTE: this is not just tidiness. A listings key that takes a bracketed class
% index -- `keywordstyle = [2]...`, needed for the second keyword class -- runs
% away and dies with "File ended while scanning use of \lstKV@OptArg@@" when it
% is routed through tcolorbox's `listing options`, while working perfectly in a
% plain \lstset. Keeping every bracketed key inside \lstdefinestyle, where
% \lstset sees it directly, sidesteps that entirely.
\lstdefinestyle{notexpseudostyle}{
  language        = notexpseudo,
  mathescape      = true,                         % math mode inside '$'
  basicstyle      = \ttfamily\small,
  keywordstyle    = \color{red}\bfseries,         % control flow / structure
  keywordstyle    = [2]\color{purple},            % common "builtins"
  commentstyle    = \color{commentscolor}\itshape,
  stringstyle     = \color{azure},
  numberstyle     = \color{numerscolor}\ttfamily\scriptsize,
  numbersep       = 1.3mm,
  breaklines      = true,
  breakatwhitespace = false,
  keepspaces      = true,
  showspaces      = false,
  showstringspaces = false,
  showtabs        = false,
  tabsize         = 4,
  xleftmargin     = 0mm,
  aboveskip       = -0.5mm,
  belowskip       = -0.5mm,
}

% Only the parts that vary per block are left dynamic here. Kept in a macro for
% the same \edef reason as the minted options above.
\def\notex@code@lstopts{%
  listing engine  = listings,     % NOT minted -- see the NOTE below
  listing options = {
    style = notexpseudostyle,
    \ifnotex@code@linenos numbers = left,\else numbers = none,\fi
    \unexpanded\expandafter{\notex@code@extra}}}

% NOTE: `listing engine` MUST be stated explicitly. Both \tcbuselibrary{listings}
% and \tcbuselibrary{minted} install a reset style that sets it, and the one
% loaded LAST wins as the global default. Since this package loads the minted
% library after the listings one, a box that does not set the engine itself
% silently renders through minted, which ignores every `listing options` key
% above (`language`, `mathescape`, `commentstyle`, ...).
\NewDocumentEnvironment{pseudocode}{ !O{} }
  {\notex@code@start{#1}{\notex@code@lstopts}}
  {\notex@code@stop}

\makeatother

%┌────────────────────────────────────────────────────────────────────────────┐%
%│                                Inline Code                                 │%
%└────────────────────────────────────────────────────────────────────────────┘%

% Markdown-style inline code with a colored background and no highlighting.
% Reference: look at pag. 21 of the tcolorbox manual for inline boxes
\newcommand{\cc}[1]{
  \kern-1ex                       % negative space
  \tcbox[
    on line,                      % inline
    colback   = boxcolor,         % background color
    coltext   = textcolor!60,     % text color
    colframe  = boxcolor,         % frame color
    boxrule   = 0pt,              % frame thickness
    boxsep    = 0.5pt,            % frame separation
    top       = 0.5mm,            % top margin
    bottom    = 0.5mm,            % bottom margin
    left      = 0.5mm,            % left margin
    right     = 0.5mm             % right margin
  ]
  {\texttt{#1}}                   % code text
  \kern-1ex                       % negative space
}

% Syntax-highlighted inline code.
% The theme's style comes from the \setminted call further up, which applies
% to \mintinline too, so there is nothing per-theme to do here.
\NewDocumentCommand{\inline}{ O{bash} m }{\mintinline{#1}{#2}}
